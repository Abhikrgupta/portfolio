---
import { profile } from '../data/profile';
import EmailLink from './EmailLink.astro';
const { contact, identity } = profile;
---

<section id="contact" class="contact-section">
  <div class="container">
    <div class="section-label">Connect</div>
    <h2 class="section-title">{contact.heading}</h2>
    <p class="section-desc">{contact.description}</p>

    <div class="contact-grid">
      <!-- Card 1: LinkedIn -->
      <a href={identity.linkedIn} target="_blank" rel="noopener noreferrer" class="card contact-card">
        <div class="card-icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </div>
        <div class="card-body-content">
          <span class="card-platform">LinkedIn</span>
          <span class="card-label">in/abhikrgupta</span>
        </div>
        <div class="card-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17 17 7M7 7h10v10"/>
          </svg>
        </div>
      </a>

      <!-- Card 2: GitHub -->
      <a href={identity.github} target="_blank" rel="noopener noreferrer" class="card contact-card">
        <div class="card-icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </div>
        <div class="card-body-content">
          <span class="card-platform">GitHub</span>
          <span class="card-label">github.com/Abhikrgupta</span>
        </div>
        <div class="card-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17 17 7M7 7h10v10"/>
          </svg>
        </div>
      </a>

      <!-- Card 3: Email (Client-side protected) -->
      <div class="card contact-card email-card">
        <div class="card-icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </div>
        <div class="card-body-content">
          <span class="card-platform">Email</span>
          <EmailLink />
        </div>
        <div class="card-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17 17 7M7 7h10v10"/>
          </svg>
        </div>
      </div>

      <!-- Card 4: Writing -->
      <a href="/writing" class="card contact-card">
        <div class="card-icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <path d="M6 6h10"></path>
            <path d="M6 10h10"></path>
          </svg>
        </div>
        <div class="card-body-content">
          <span class="card-platform">Writing</span>
          <span class="card-label">Selected Notes &amp; Essays</span>
        </div>
        <div class="card-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17 17 7M7 7h10v10"/>
          </svg>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 4.5rem 0 5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    text-decoration: none;
    cursor: pointer;
  }

  .card-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-mint);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .contact-card:hover .card-icon-box {
    background: rgba(0, 255, 157, 0.1);
    border-color: var(--border-mint);
    transform: scale(1.05);
  }

  .card-body-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .card-platform {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .card-arrow {
    color: var(--text-dim);
    transition: all 0.2s ease;
  }

  .contact-card:hover .card-arrow {
    color: var(--accent-mint);
    transform: translate(2px, -2px);
  }

  @media (max-width: 650px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
