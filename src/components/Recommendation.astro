---
import { profile } from '../data/profile';
const { recommendation } = profile;
---

<section class="recommendation-section">
  <div class="container">
    <div class="section-label">Endorsement</div>
    <div class="card rec-card">
      <div class="quote-watermark">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="currentColor" opacity="0.06">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>
      </div>

      <div class="rec-quote-body">
        {recommendation.quote.map((paragraph) => (
          <p class="quote-paragraph">{paragraph}</p>
        ))}
      </div>

      <div class="rec-footer">
        <div class="author-block">
          <div class="author-avatar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>

          <div class="author-info">
            <div class="name-row">
              <h3 class="author-name">{recommendation.author}</h3>
              <span class="verified-badge" title="Verified Colleague Recommendation">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
              </span>
              <span class="source-tag">{recommendation.source}</span>
            </div>
            <p class="author-role">{recommendation.role}</p>
            <p class="relationship-note">{recommendation.relationship} • {recommendation.date}</p>
          </div>
        </div>

        <div class="competencies-block">
          <span class="competencies-label">Demonstrated Competencies:</span>
          <div class="competencies-chips">
            {recommendation.qualities.map((quality) => (
              <span class="quality-tag">✓ {quality}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .recommendation-section {
    padding: 3rem 0 4.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .rec-card {
    position: relative;
    padding: 2.75rem;
    border: 1px solid rgba(0, 255, 157, 0.25);
    background: linear-gradient(135deg, rgba(12, 18, 32, 0.9) 0%, rgba(6, 10, 18, 0.98) 100%);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4), var(--glow-mint);
    overflow: hidden;
  }

  .quote-watermark {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    color: var(--accent-mint);
    pointer-events: none;
  }

  .rec-quote-body {
    position: relative;
    z-index: 1;
    margin-bottom: 2rem;
    border-left: 3px solid var(--accent-mint);
    padding-left: 1.5rem;
  }

  .quote-paragraph {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #e2e8f0;
    margin-bottom: 1.15rem;
  }

  .quote-paragraph:last-child {
    margin-bottom: 0;
  }

  .rec-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.75rem;
  }

  .author-block {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .author-avatar-icon {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background: rgba(0, 255, 157, 0.08);
    border: 1px solid rgba(0, 255, 157, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-mint);
    flex-shrink: 0;
  }

  .name-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }

  .author-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .verified-badge {
    color: var(--accent-mint);
    display: flex;
    align-items: center;
  }

  .source-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-cyan);
    background: rgba(0, 212, 255, 0.08);
    border: 1px solid rgba(0, 212, 255, 0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .author-role {
    font-size: 0.92rem;
    color: var(--accent-mint);
    font-weight: 500;
    margin-bottom: 0.2rem;
  }

  .relationship-note {
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .competencies-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .competencies-label {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .competencies-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .quality-tag {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--accent-mint);
    background: rgba(0, 255, 157, 0.06);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 255, 157, 0.18);
  }

  @media (max-width: 768px) {
    .rec-card {
      padding: 1.75rem;
    }

    .rec-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }
</style>
