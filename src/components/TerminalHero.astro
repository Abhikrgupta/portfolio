---
import { profile } from '../data/profile';
const { hero, terminal, identity } = profile;
---

<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="hero-identity-bar">
        <div class="avatar-frame">
          <img
            src="/images/avatar.webp"
            alt="Abhishek Kumar Gupta"
            width="96"
            height="96"
            class="avatar-img"
            onerror="this.onerror=null; this.src='/images/avatar.svg';"
          />
        </div>
        <div class="identity-text">
          <h1 class="hero-name">{hero.name}</h1>
          <p class="hero-role">
            <span class="role-badge">{hero.role}</span>
          </p>
          <p class="hero-positioning">{identity.primaryPositioning}</p>
        </div>
      </div>

      <h2 class="hero-headline">
        {hero.headlineStart}<span class="highlight-mint">{hero.headlineEmphasized}</span>{hero.headlineEnd}
      </h2>

      <p class="hero-desc">{hero.description}</p>

      <div class="hero-cta-group">
        <a href={hero.primaryCta.href} class="btn btn-primary">
          <span>{hero.primaryCta.text}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </a>

        <a href={hero.secondaryCta.href} class="btn btn-secondary">
          <span>{hero.secondaryCta.text}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>

        <a href={hero.thirdCta.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <span>{hero.thirdCta.text}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h6v6"/>
            <path d="M10 14 21 3"/>
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Monospace Terminal Window -->
    <div class="terminal-container">
      <div class="terminal-window">
        <div class="terminal-header">
          <div class="terminal-controls">
            <span class="control close"></span>
            <span class="control minimize"></span>
            <span class="control maximize"></span>
          </div>
          <span class="terminal-title">{terminal.title}</span>
          <span class="terminal-session">bash</span>
        </div>

        <div class="terminal-body">
          {terminal.entries.map((item) => (
            <div class="terminal-row">
              <div class="terminal-cmd">
                <span class="prompt">$</span> {item.cmd}
              </div>
              <div class="terminal-out">{item.output}</div>
            </div>
          ))}
          <div class="terminal-cursor-row">
            <span class="prompt">$</span> <span class="blinking-cursor">_</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 4rem 0 3.5rem;
    position: relative;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-identity-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .avatar-frame {
    width: 96px;
    height: 96px;
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1.5px solid var(--border-mint);
    box-shadow: var(--glow-mint);
    background: var(--bg-elevated);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-name {
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .hero-role {
    margin-bottom: 0.25rem;
  }

  .role-badge {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent-mint);
    background: rgba(0, 255, 157, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(0, 255, 157, 0.2);
    display: inline-block;
  }

  .hero-positioning {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .hero-headline {
    font-size: 2.35rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .highlight-mint {
    color: var(--accent-mint);
    text-shadow: 0 0 20px rgba(0, 255, 157, 0.35);
  }

  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin-bottom: 2rem;
    max-width: 54ch;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--accent-mint);
    color: #060a12;
    border: 1px solid var(--accent-mint);
  }

  .btn-primary:hover {
    background: #05e58d;
    box-shadow: 0 0 16px rgba(0, 255, 157, 0.4);
    transform: translateY(-1px);
    color: #060a12;
  }

  .btn-secondary {
    background: rgba(12, 18, 32, 0.9);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-secondary:hover {
    border-color: var(--border-mint);
    color: var(--accent-mint);
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-muted);
    border: 1px solid transparent;
  }

  .btn-ghost:hover {
    color: var(--accent-cyan);
  }

  /* Terminal Styling */
  .terminal-container {
    width: 100%;
  }

  .terminal-window {
    background: #080d18;
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.6), var(--glow-mint);
    overflow: hidden;
    font-family: var(--font-mono);
  }

  .terminal-header {
    background: #0d1525;
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .terminal-controls {
    display: flex;
    gap: 6px;
  }

  .control {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .control.close { background: #ff5f56; }
  .control.minimize { background: #ffbd2e; }
  .control.maximize { background: #27c93f; }

  .terminal-title {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .terminal-session {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .terminal-body {
    padding: 1.25rem 1.25rem 1.5rem;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .terminal-row {
    margin-bottom: 1rem;
  }

  .terminal-cmd {
    color: var(--text-primary);
  }

  .prompt {
    color: var(--accent-mint);
    margin-right: 0.35rem;
    font-weight: 700;
  }

  .terminal-out {
    color: var(--accent-cyan);
    margin-top: 0.25rem;
    padding-left: 1rem;
    font-size: 0.85rem;
  }

  .terminal-cursor-row {
    color: var(--text-primary);
  }

  .blinking-cursor {
    color: var(--accent-mint);
    animation: blink 1s step-start infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-headline {
      font-size: 1.95rem;
    }
  }
</style>
