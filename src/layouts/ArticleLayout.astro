---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  tags: string[];
  readingTime?: string;
}

const { title, description, date, tags, readingTime } = Astro.props;

// Format date nicely: "November 8, 2025"
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${title} | Abhishek Kumar Gupta`} description={description}>
  <article class="article-container">
    <div class="container article-inner">
      <nav class="back-nav">
        <a href="/writing" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          <span>Back to selected notes</span>
        </a>
      </nav>

      <header class="article-header">
        <div class="article-meta">
          <time datetime={date} class="article-date">{formattedDate}</time>
          {readingTime && <span class="meta-dot">•</span>}
          {readingTime && <span class="article-reading-time">{readingTime}</span>}
        </div>

        <h1 class="article-title">{title}</h1>

        <p class="article-lead">{description}</p>

        <div class="article-tags">
          {tags.map((tag) => (
            <span class="badge badge-cyan">{tag}</span>
          ))}
        </div>
      </header>

      <div class="article-content">
        <slot />
      </div>

      <footer class="article-footer">
        <div class="article-share">
          <span class="share-label">Questions or discussion on this note?</span>
          <a
            href="https://www.linkedin.com/in/abhikrgupta"
            target="_blank"
            rel="noopener noreferrer"
            class="share-link"
          >
            Connect on LinkedIn
          </a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    padding: 3rem 0 5rem;
  }

  .article-inner {
    max-width: 74ch;
    margin: 0 auto;
  }

  .back-nav {
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-family: var(--font-mono);
    color: var(--accent-mint);
    transition: all 0.15s ease;
  }

  .back-link:hover {
    color: #ffffff;
    transform: translateX(-3px);
  }

  .article-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }

  .meta-dot {
    color: var(--text-dim);
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .article-lead {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Deep Markdown Content Styling */
  .article-content {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #cbd5e1;
  }

  .article-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 2.75rem 0 1.25rem;
    letter-spacing: -0.015em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.5rem;
  }

  .article-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent-mint);
    margin: 2rem 0 0.85rem;
  }

  .article-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-content :global(ul), .article-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .article-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: rgba(0, 255, 157, 0.08);
    color: var(--accent-mint);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 255, 157, 0.15);
  }

  .article-content :global(pre) {
    background: #080d18;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.75rem 0;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .article-content :global(pre code) {
    background: none;
    padding: 0;
    border: none;
    color: var(--accent-cyan);
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--accent-mint);
    padding: 0.75rem 1.25rem;
    background: rgba(0, 255, 157, 0.04);
    border-radius: 0 8px 8px 0;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--text-primary);
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 2.5rem 0;
  }

  .article-footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: 3.5rem;
    padding-top: 2rem;
  }

  .article-share {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }

  .share-label {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .share-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-mint);
    text-decoration: underline;
  }

  .share-link:hover {
    color: #ffffff;
  }

  @media (max-width: 650px) {
    .article-title {
      font-size: 1.85rem;
    }
  }
</style>
